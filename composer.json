{
    "name": "akumi-cloud/sdk",
    "description": "Official PHP SDK for the Akumi EU-sovereign inference API.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "php-http/discovery": "^1.19"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client implementation",
        "illuminate/support": "For the optional Laravel service provider"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^11.0|^12.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": { "Akumi\\Sdk\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Akumi\\Sdk\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Akumi\\Sdk\\Laravel\\AkumiServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
